<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Security Logs</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#0d1117;
color:white;
}

.header{
background:#161b22;
padding:20px;
text-align:center;
font-size:28px;
color:cyan;
box-shadow:0 0 10px cyan;
}

.container{
width:95%;
margin:30px auto;
}

h2{
color:cyan;
margin-bottom:20px;
}

table{
width:100%;
border-collapse:collapse;
background:#161b22;
box-shadow:0 0 10px cyan;
}

th{
background:cyan;
color:black;
padding:14px;
}

td{
padding:12px;
text-align:center;
border:1px solid gray;
}

.success{
color:lightgreen;
font-weight:bold;
}

.warning{
color:orange;
font-weight:bold;
}

.danger{
color:red;
font-weight:bold;
}

.back{
text-align:center;
margin-top:30px;
}

.back a{
background:cyan;
color:black;
padding:12px 25px;
text-decoration:none;
border-radius:8px;
font-weight:bold;
}

.back a:hover{
background:#00bcd4;
}

</style>

</head>

<body>

<div class="header">

📋 Security Logs

</div>

<div class="container">

